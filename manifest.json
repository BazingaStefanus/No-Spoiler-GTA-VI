{
  "manifest_version": 3,
  "name": "No Spoiler for GTA VI",
  "version": "1.0.0",
  "description": "Blendet Spoiler zu GTA VI auf Webseiten aus: Texte werden geschwärzt, Bilder und Videos unkenntlich gemacht.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "No Spoiler for GTA VI",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/storage.js", "src/matcher.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
